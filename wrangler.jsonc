{
  // Configuração do Cloudflare: site estático (Eleventy, em ./_site) + sistema Diligo em /sistema.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Só /sistema passa pelo código; o resto do site continua servido direto como arquivos.
    "run_worker_first": ["/sistema", "/sistema/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diligo",
      "database_id": "6e583790-963f-42d5-beff-4e809593403c",
      "migrations_dir": "migrations"
    }
  ],
  // Mantém variáveis cadastradas pelo painel ao publicar.
  "keep_vars": true,
  "observability": { "enabled": true }
  // Segredos (configurar no painel, nunca aqui): DATA_KEY, SETUP_TOKEN, WIX_API_KEY
}
