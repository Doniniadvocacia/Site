{
  // Configuração do Cloudflare: site estático (Eleventy, em ./_site) + sistema Diligo em /sistema.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Só /sistema passa pelo código; o resto do site continua servido direto como arquivos.
    "run_worker_first": ["/sistema", "/sistema/*"]
  },
  // "d1_databases": entra aqui quando o banco D1 "diligo" estiver criado.
  "observability": { "enabled": true }
  // Segredos (configurar no painel, nunca aqui): DATA_KEY, SETUP_TOKEN, WIX_API_KEY
}
