{
  // Configuração do Cloudflare (Workers com arquivos estáticos).
  // O site é gerado pelo Eleventy em ./_site e publicado como está.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
