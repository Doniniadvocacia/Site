---
layout: base.njk
pagination:
  data: areas
  size: 1
  alias: area
  addAllPagesToCollections: true
permalink: "/areas/{{ area.slug }}/"
eleventyComputed:
  title: "{{ area.titulo }}"
  description: "{{ area.resumo }}"
---
<section class="pagina-topo">
  <p class="rotulo"><a href="/areas-de-atuacao/">Áreas de atuação</a></p>
  <h1>{{ area.titulo }}</h1>
</section>

<section class="texto-area">
  {% for p in area.texto %}<p>{{ p }}</p>{% endfor %}

  <h2>Principais temas</h2>
  <ul class="lista-temas">
    {% for t in area.temas %}<li>{{ t }}</li>{% endfor %}
  </ul>
</section>

{% include "chamada-contato.njk" %}

<nav class="outras-areas">
  <h2>Outras áreas</h2>
  <ul>
    {% for a in areas %}{% if a.slug != area.slug %}<li><a href="/areas/{{ a.slug }}/">{{ a.titulo }}</a></li>{% endif %}{% endfor %}
  </ul>
</nav>
