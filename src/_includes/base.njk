<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.nome }}</title>
  <meta name="description" content="{{ description or site.descricao }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.nome }}">
  <meta property="og:description" content="{{ description or site.descricao }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="pt_BR">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/img/icone-180.png">
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"LegalService","name":"{{ site.nome }}","url":"{{ site.url }}","email":"{{ site.email }}","areaServed":"BR","sameAs":["{{ site.instagram }}","{{ site.linkedin }}"]}
  </script>
  {% endif %}
</head>
<body>
  <header class="topo">
    <a class="marca" href="/" aria-label="Eduardo Donini Advocacia — página inicial"><img src="/assets/img/logo-eduardo-donini.webp" alt="Eduardo Donini Advocacia" width="477" height="87"></a>
    <nav aria-label="Principal">
      <a href="/areas-de-atuacao/"{% if "/area" in page.url %} aria-current="page"{% endif %}>Áreas de atuação</a>
      <a href="/artigos/"{% if "/artigos" in page.url %} aria-current="page"{% endif %}>Artigos</a>
      <a href="/contato/"{% if page.url == "/contato/" %} aria-current="page"{% endif %}>Contato</a>
      <a class="nav-acesso" href="/acesso/"{% if page.url == "/acesso/" %} aria-current="page"{% endif %}>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Área restrita
      </a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="rodape">
    <p class="rodape-marca">{{ site.nome }} · {{ site.oab }}</p>
    <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <p><a href="{{ site.instagram }}">Instagram</a> · <a href="{{ site.linkedin }}">LinkedIn</a> · <a href="/politica-de-privacidade/">Política de privacidade</a></p>
  </footer>
</body>
</html>
